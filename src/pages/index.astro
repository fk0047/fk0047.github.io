---
import Base from '../layouts/Base.astro';
import { P, S, C, X, SO, BR, O, OLD, RQ, CB, CI } from '../data/site.js';
import { BI } from '../data/brandicons.js';

const A = '/assets/projects/';
const chip = (n) => BR[n] || null;
const total = C.length + X.length + 1;
const yr = w => (w.match(/\d{4}/) || ['Portfolio'])[0];
const status = w => /Present/.test(w) ? 'Ongoing' : 'Shipped';
const order = ['EZAI / EZ-AD Enterprise','EZ-Medical AI','Dentaloo','EZ-AD TV','True Value Rewards','True Value MTS+ app','EZ-AD Digital Commerce','EZ-AD TV Android & iOS apps','Issa Dental Group','SOCH Psychological Clinics'];
const feed = order.map(t => P.find(p => p.t === t)).filter(Boolean);
const archive = P.filter(p => !feed.includes(p) && p.i);
const older = P.filter(p => !feed.includes(p) && !p.i);
const googleFeat = C.filter(c => c[6]).slice(0, 6);
const restCerts = C.filter(c => !c[6]).concat(C.filter(c => c[6]).slice(6));
const view = c => c[4] ? `/certificates/${c[4]}.pdf` : '';
const extraName = x => x.replace(/ \(.*\)$/, '');
const extraIss = x => (x.match(/\((.*)\)$/) || ['', ''])[1];
const PL = {'EZAI / EZ-AD Enterprise':'ezai','EZ-Medical AI':'ezmedical','Dentaloo':'dentaloo','EZ-AD TV':'ezadapp','True Value Rewards':'tvr','True Value MTS+ app':'mts','EZ-AD Digital Commerce':'ezadapp','EZ-AD TV Android & iOS apps':'ezadapp','Issa Dental Group':'issa','SOCH Psychological Clinics':'soch'};
const nv = t => t.replace(/\s*\((v|V)\d\)|\s+V\d$/g, '');
const LOGO = {'EZ-AD TV':'ezad','Working Ladies In Progress':'wlip','Vortex International':'vortex','Tech Switch':'techswitch','Atrix Digital Solutions':'atrix'};
const PH = {'Rolan Reichel':'rolan','Lawrence Mansour':'lawrence','Kevin Hercog':'kevin','Haris Ahmed':'haris','Faryal Anjum':'faryal','Ahsan Hussain':'ahsan','Arslan Qamar':'arslan','Moeid Saleem Khan':'moeid','Belbron Emanoel':'belbron'};
const ini = n => n.replace(/\(.*?\)/g,'').split(/[\s/]+/).filter(Boolean).slice(0,2).map(w => w[0]).join('').toUpperCase();
const SG = [['Product & Delivery',[16]],['AI & LLMs',[0,3,2,1]],['Code & Mobile',[8,9,10,12]],['Cloud, DevOps & Data',[11,6,7]],['APIs & Integrations',[19,5]],['Web3 & Payments',[4,14]],['Commerce & Marketing',[13,17,18]],['Security & IT',[15]]].map(([h, ix]) => { const seen = new Set(); return [h, ix.map(i => [S[i][0] === 'AI & LLMs' ? 'Models & agents' : S[i][0], S[i][1].filter(n => { const k = n.toLowerCase().replace(/^google /,''); if (seen.has(k)) return false; seen.add(k); return true; })]).filter(g => g[1].length)]; });
const orgs = O.map((o, i) => i === 2 ? { ...o, m: 'Los Angeles, CA · Remote · 2022' } : i === 3 ? { ...o, m: 'Los Angeles, CA · Remote · 2021' } : o);
const span = m => m.split(' · ').slice(-1)[0].replace(/ – /g, ' – ');
const clients = [['truevalue','True Value','png'],['doitbest','Do it Best','svg',1],['ace','Ace Hardware','png',1],['walmart','Walmart','png'],['disney','Disney','png',1],['3m','3M','png',1],['adp','ADP','png',1],['verizon','Verizon','png'],['spectrum','Spectrum','png'],['timbertech','TimberTech (AZEK)','svg'],['jameshardie','James Hardie','svg'],['milwaukee','Milwaukee Tool','svg',1],['bm','Benjamin Moore','png',1],['orgill','Orgill','svg'],['allpro','Allpro','png',1],['sally','Sally Beauty','png',1],['pfchangs','P.F. Chang’s','png'],['kfc','KFC','png',1],['carlsjr','Carl’s Jr.','png'],['shakeshack','Shake Shack','png'],['hungryhowies','Hungry Howie’s','png',1],['fema','FEMA','png',1],['tsa','TSA','png',1],['bigmarker','BigMarker','svg'],['ezad','EZ-AD','png'],['dentaloo','Dentaloo','svg'],['issa','Issa Dental Group','svg',1],['soch','SOCH Clinics','svg']];
const tile = (f) => { const I = BI[f]; if (!I) return null; const dark = ['x','tiktok','threads'].includes(f); const inv = ['youtube','pinterest','google-business'].includes(f); const ko = {linkedin:['#0A66C2','2','2','20','20'],facebook:['#0866FF','7.5','4','9.5','20'],telegram:['#2AABEE','4.5','5.5','15','13']}[f]; const st = ko ? `--fg:${ko[0]}` : inv ? `--fg:${I.bg}` : (I.bg === 'IG' || dark ? '' : `--bg:${I.bg}`); return { cls: `tile ${f}${dark ? ' dark' : ''}${inv ? ' inv' : ''}${ko ? ' ko' : ''}`, st, ko, p: I.p }; };
---
<Base>
<a class="mark" href="#top" aria-label="Back to top"><span>FK</span></a>
<nav class="pills" aria-label="Main">
  <div class="pill"><a href="#work">Work</a><a href="#about">About</a><a href="#skills">Skills</a><a href="#praise">Praise</a></div>
  <a class="pill res" href="/assets/Fahad_Khan_Resume.pdf" target="_blank"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h8l5 5v15H6z" fill="currentColor"/><path d="M14 2v5h5" fill="#fff" opacity=".5"/></svg>Resume</a>
</nav>
<a class="sidetab" href="#credentials"><b>{total}</b><span>Certifications</span></a>

<header class="hero" id="top">
  <div class="hang" id="hang">
    <div class="strap" aria-hidden="true"><span>FAHAD KHAN · FK0047 · FAHAD KHAN · FK0047 · FAHAD KHAN</span></div>
    <div class="clip" aria-hidden="true"><i></i></div>
    <article class="badge" id="badge">
      <div class="slot" aria-hidden="true"></div>
      <div class="photo"><img src="/assets/fahad.jpg" alt="Fahad Khan"></div>
      <div class="seal" aria-hidden="true">FK</div>
      <div class="bbody">
        <div class="nm"><h1>FAHAD KHAN</h1><svg class="tick" viewBox="0 0 24 24" aria-label="Verified"><path d="M12 1.5l2.6 2 3.3-.3.9 3.2 2.8 1.8-1.2 3.1 1.2 3.1-2.8 1.8-.9 3.2-3.3-.3-2.6 2-2.6-2-3.3.3-.9-3.2-2.8-1.8 1.2-3.1L2.4 8.2l2.8-1.8.9-3.2 3.3.3z" fill="#2f8cff"/><path d="M8 12.2l2.6 2.6L16.3 9" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <a class="li" href="https://www.linkedin.com/in/fk0047/" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24"><rect width="24" height="24" rx="4" fill="#0a66c2"/><path d={BI.linkedin.p} fill="#fff" transform="translate(4 4) scale(.667)"/></svg></a></div>
        <p class="rl mono">AI Product Manager</p>
        <p class="bio">I turn ideas into products people use. AI, SaaS, digital signage, marketing tech, commerce and Web3, from the first spec to launch day. I lead the team, talk to the client and ship.</p>
        <div class="bfoot mono"><a href="mailto:chronos0047@gmail.com">chronos0047@gmail.com</a><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="2.5" fill="currentColor"/></svg>Pakistan · Remote</span></div>
      </div>
    </article>
  </div>
  <a class="connect mono" href="https://www.linkedin.com/in/fk0047/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="3" fill="#fff"/><path d={BI.linkedin.p} fill="#0a66c2" transform="translate(4 4) scale(.667)"/></svg>Lets connect</a>
  <p class="roles mono">Product Owner · Technical Project Manager · Scrum Master · Business Analyst · Fractional CTO</p>
</header>

<main id="work" class="wrap">
  <div class="sh rv"><h3>Selected work</h3><p class="label">Ten products I led end to end. Open any one for what I did.</p></div>
  <div class="feed">
  {feed.map((p, i) => (
    <section class="proj rv">
      <div class="phead">
        <div class="pl">
          {PL[p.t] ? <img class="pic" src={`/assets/plogos/${PL[p.t]}.jpg`} alt=""> : <span class="pic" style={`background:linear-gradient(135deg,${p.g ? p.g[0] : '#333'},${p.g ? p.g[1] : '#111'})`}>{p.t.replace(/[^A-Za-z]/g,'')[0]}</span>}
          <div><h2>{p.t}</h2></div>
        </div>
        <p class="pd">{p.d}{p.u && p.u[0] && <> <a class="ul" href={p.u[0][1]} target="_blank" rel="noopener">{p.u[0][0]} ↗</a></>}</p>
      </div>
      <div class="shot">{p.i.slice(0, 1).map((k, j) => <img loading={i < 2 ? 'eager' : 'lazy'} src={`${A}${k}.jpg`} alt={`${p.t} screenshot ${j + 1}`}>)}</div>
      <details class="more"><summary class="mono">What I did</summary><ul>{(p.b || []).map(x => <li>{x}</li>)}</ul>{p.s && <p class="stack mono">{p.s.join(' · ')}</p>}</details>
    </section>
  ))}
  </div>

  <section id="archives" class="arch rv">
    <div class="sh"><h3>Other projects</h3><p class="label">{archive.length + older.length} more products, portfolio pieces and earlier work.</p></div>
    <div class="agrid">
      {archive.map(p => (
        <details class="ac">
          <summary>
            {p.i ? <img loading="lazy" class={p.x ? 'ct' : ''} src={`${A}${p.i[0]}.jpg`} alt=""> : <span class="ph" style={`background:linear-gradient(135deg,${p.g ? p.g[0] : '#ddd'},${p.g ? p.g[1] : '#999'})`}>{p.t.replace(/[^A-Za-z]/g,'')[0]}</span>}
            <b>{p.t}</b>
          </summary>
          <p>{p.d}</p><ul>{(p.b || []).map(x => <li>{x}</li>)}</ul>
          {p.u && <p class="lk">{p.u.map(([n, h]) => <a class="ul" href={h} target="_blank" rel="noopener">{n} ↗</a>)}</p>}
        </details>
      ))}
    </div>
    <div class="olist">{older.map(p => <details class="oi"><summary><b>{p.t}</b></summary><p>{p.d}</p><ul>{(p.b || []).map(x => <li>{x}</li>)}</ul>{p.u && <p class="lk">{p.u.map(([n, h]) => <a class="ul" href={h} target="_blank" rel="noopener">{n} ↗</a>)}</p>}</details>)}</div>
  </section>
</main>

<section class="clients wrap rv" id="brands">
  <div class="sh"><h3>Clients and brands</h3><p class="label">Retail, restaurant, government and enterprise brands I've delivered for.</p></div>
  <div class="logos">{clients.map(([f, n, e, t]) => <img class={t ? 't' : ''} src={`/assets/clients/${f}.${e}`} alt={n} title={n} loading="lazy">)}</div>
  <div class="socials">{SO.map(([f, n]) => { const T = tile(f); return T && <div class="so"><span class={T.cls} style={T.st}><svg viewBox="0 0 24 24" aria-hidden="true">{T.ko && <rect x={T.ko[1]} y={T.ko[2]} width={T.ko[3]} height={T.ko[4]} fill="#fff"/>}<path d={T.p}/></svg></span>{n}</div>; })}</div>
</section>

<section class="about wrap" id="about">
  <div class="al rv">
    <img class="me" src="/assets/fahad.jpg" alt="Fahad Khan">
    <div class="kv"><p class="label">Education</p><p class="ed"><img src="/assets/comsats.png" alt="">BSc Software Engineering<br><span>COMSATS University Islamabad · 2014 – 2018</span></p></div>
    <div class="kv"><p class="label">Certifications · {total} in total</p>
      <ul class="cl">
        {googleFeat.slice(0, 5).map(c => <li><span class="ci-ic g"><svg viewBox="0 0 24 24"><path d={BI.google.p}/></svg></span>{nv(c[0])}</li>)}
        {C.filter(c => c[1] === 'PMI').map(c => <li><span class="ci-ic pmi">PMI</span>{c[0]}</li>)}
        {C.filter(c => c[1] === 'Anthropic').map(c => <li><span class="ci-ic cl"><svg viewBox="0 0 24 24"><path d={BI.claude.p}/></svg></span>{c[0]}</li>)}
        {C.filter(c => c[1] === 'Atlassian').slice(0, 1).map(c => <li><span class="ci-ic at"><svg viewBox="0 0 24 24"><path d={BI.atlassian.p}/></svg></span>{c[0]}</li>)}
        <li><span class="ci-ic pmi">PMI</span>PMP <em>in progress</em></li>
      </ul>
    </div>
  </div>
  <div class="ar rv">
    <p class="label">About me</p>
    <div class="txt">
      <p>I build products people actually use, across AI, SaaS, digital signage, marketing tech, commerce and Web3. I've shipped 50+ products and wired up 30+ APIs, mostly for US retail and enterprise brands.</p>
      <p>I lead the team, I talk to the client, and I own the delivery. Developers, QA, UI/UX and marketing, side by side with IT, sales and support. I write the specs, run the sprints and keep everyone pointed at the same launch day.</p>
      <p>Outside of work I'm gaming, reading up on new tech, catching the latest anime, or out at the movies with friends.</p>
    </div>
    <div class="stats mono"><span><b>50+</b> products</span><span><b>30+</b> APIs</span><span><b>{total}</b> certifications</span><span><b>9 yrs</b> remote</span></div>
    <div class="xp" id="experience">
      {orgs.map(o => (
        <details class="org">
          <summary>
            <span class="ol">{LOGO[o.n] ? <img src={`/assets/orgs/${LOGO[o.n]}.jpg`} alt=""> : /NDA/.test(o.n) ? <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.8"/></svg> : <i>{ini(o.n)}</i>}</span>
            <span><b>{o.n}</b> <em>· {span(o.m)}</em><br><small>{o.r.map((r, k) => <>{k > 0 && <span class="ar">{r.p ? ' → ' : ' + '}</span>}{r.t.split(' / ')[0]}</>)}</small></span>
          </summary>
          {o.r.slice().reverse().map(r => <div class="role"><p><b>{r.t}</b>{r.p && <span class="pr mono">Promoted</span>}</p><p class="label">{r.w}</p><ul>{(r.b || []).map(x => <li>{x}</li>)}</ul></div>)}
        </details>
      ))}
      <details class="older"><summary class="mono">View all roles</summary>
        {OLD.map(o => (
          <details class="org">
            <summary><span class="ol">{LOGO[o.n] ? <img src={`/assets/orgs/${LOGO[o.n]}.jpg`} alt=""> : <i>{ini(o.n)}</i>}</span><span><b>{o.n}</b> <em>· {o.r[0].w}</em><br><small>{o.r[0].t}</small></span></summary>
            {o.r.map(r => <div class="role"><p class="label">{o.m}</p><ul>{(r.b || []).map(x => <li>{x}</li>)}</ul></div>)}
          </details>
        ))}
      </details>
    </div>
    <div class="spec"><p class="label">Specialisation</p><p>Technical project management</p><p>AI product management</p><p>API integrations</p><p>Stakeholder and vendor management</p></div>
  </div>
</section>

<section class="skills wrap rv" id="skills">
  <div class="sh"><h3>Skills</h3><p class="label">From the models to the money.</p></div>
  <div class="seg" id="sseg" role="tablist" aria-label="Skill areas">{SG.map(([h], i) => <button role="tab" class={i === 0 ? 'on' : ''} data-i={i} aria-selected={i === 0 ? 'true' : 'false'}>{h}</button>)}</div>
  {SG.map(([h, gs], i) => (
    <div class="panel" role="tabpanel" data-i={i} hidden={i !== 0}>
      {gs.map(([sh, l]) => <div class="sub">{gs.length > 1 && <p class="label">{sh}</p>}<div class="chips">{l.map(n => { const b = chip(n); return <span class="chip">{b ? (b[1] ? <img src={'/' + b[1]} alt="" /> : <i style={`--b:${b[0]}`}></i>) : null}{n}</span>; })}</div></div>)}
    </div>
  ))}
</section>

<section class="creds wrap" id="credentials">
  <div class="sh rv"><h3>Certifications</h3><p class="label">{total} in total, led by Google's professional certificates. PMP is next.</p></div>
  <div class="cgrid">
    {googleFeat.map((c, i) => (
      <div class="cc rv" style={`--d:${(i % 3) * 0.06}s`}>
        {c[4] && <img loading="lazy" src={`/certificates/thumbs/${c[4]}.jpg`} alt={`${c[0]} certificate`}>}
        <p><b>{nv(c[0])}</b><br><span class="label">Google · {c[2]}</span></p>
        <p class="go mono">{c[3] && <a href={c[3]} target="_blank" rel="noopener">Verify ↗</a>}{view(c) && <a href={view(c)} target="_blank">View ↗</a>}</p>
      </div>
    ))}
  </div>
  <div class="strip rv">{CB.map(b => <a class="bdg" href="https://www.credly.com/users/fk0047" target="_blank" rel="noopener"><img loading="lazy" src={`${CI}${b[3]}`} alt=""><span>{nv(b[0])}</span></a>)}</div>
  <details class="allc rv"><summary class="mono">View all {total} certifications</summary>
    <div class="list">
      {restCerts.map(c => <div class="ci"><b>{nv(c[0])}</b><span class="label">{c[1]} · {c[2]}</span>{(c[3] || view(c)) && <span class="go mono">{c[3] && <a href={c[3]} target="_blank" rel="noopener">Verify ↗</a>}{view(c) && <a href={view(c)} target="_blank">View ↗</a>}</span>}</div>)}
      {X.map(x => <div class="ci"><b>{extraName(x)}</b><span class="label">{extraIss(x)}</span></div>)}
    </div>
  </details>
</section>

<section class="praise" id="praise">
  <div class="wrap sh rv"><h3>Recommendations</h3><p class="label">Clients, teammates and managers. <a class="ul" href="https://www.linkedin.com/in/fk0047/details/recommendations/" target="_blank" rel="noopener">Read on LinkedIn ↗</a></p></div>
  <div class="qrow rv">{RQ.map(q => <article class="q"><p>“{q[0]}”</p><cite>{PH[q[1]] ? <img src={`/assets/people/${PH[q[1]]}.jpg`} alt="" loading="lazy"> : <i>{ini(q[1])}</i>}<span><b>{q[1]}</b><small>{q[2]}</small></span></cite></article>)}</div>
</section>

<section class="life wrap rv" id="beyond">
  <div class="sh"><h3>Outside work</h3><p class="label">Gaming, tech, anime, and movie nights with friends.</p></div>
  <div class="lgrid">
    <figure style="--c:url(/assets/life/gaming.jpg)"><figcaption>Gaming</figcaption></figure>
    <figure style="--c:url(/assets/life/tech.jpg)"><figcaption>Tech</figcaption></figure>
    <figure style="--c:url(/assets/life/anime.jpg)" class="top"><figcaption>Anime</figcaption></figure>
    <figure style="--c:url(/assets/life/movies.jpg)"><figcaption>Shows &amp; movies</figcaption></figure>
  </div>
</section>

<section class="contact wrap rv" id="contact">
  <h3>Let's build <em>what's next.</em></h3>
  <p class="label">Open to remote roles and contract work, any time zone.</p>
  <div class="cways">
    <a href="https://wa.me/923414480088" target="_blank" rel="noopener"><span class="tile sm whatsapp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={BI.whatsapp.p}/></svg></span><span><small class="label">WhatsApp</small><b>+92 341 4480088</b></span></a>
    <a href="mailto:chronos0047@gmail.com"><span class="tile sm mail"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="#fff"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5" fill="none" stroke="#1E7CF2" stroke-width="1.6" stroke-linejoin="round"/></svg></span><span><small class="label">Email</small><b>chronos0047@gmail.com</b></span></a>
    <a href="https://www.linkedin.com/in/fk0047/" target="_blank" rel="noopener"><span class="tile sm linkedin ko" style="--fg:#0A66C2"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" fill="#fff"/><path d={BI.linkedin.p}/></svg></span><span><small class="label">LinkedIn</small><b>in/fk0047</b></span></a>
    <a href="https://github.com/fk0047" target="_blank" rel="noopener"><span class="tile sm github dark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={BI.github.p}/></svg></span><span><small class="label">GitHub</small><b>fk0047</b></span></a>
  </div>
</section>

<footer class="wrap foot"><a href="mailto:chronos0047@gmail.com">chronos0047@gmail.com</a><span><a href="https://www.linkedin.com/in/fk0047/" target="_blank" rel="noopener">LinkedIn</a><a href="https://github.com/fk0047" target="_blank" rel="noopener">GitHub</a><a href="https://www.credly.com/users/fk0047" target="_blank" rel="noopener">Credly</a></span></footer>
</Base>

<style is:global>
/* chrome */
.mark{position:fixed;top:18px;left:24px;z-index:60;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--soft);box-shadow:0 0 0 1px var(--line),0 4px 14px rgba(0,0,0,.06);font-family:var(--mono);font-size:14px;font-weight:500;letter-spacing:-.02em}
.mark span{background-clip:text;color:var(--or)}
.pills{position:fixed;top:18px;right:24px;z-index:60;display:flex;gap:8px}
.pill{display:flex;align-items:center;gap:22px;height:44px;padding:0 20px;border-radius:12px;background:rgba(28,28,33,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);font-family:var(--mono);font-size:12.5px;text-transform:uppercase;letter-spacing:.02em;color:#9a9aa1;clip-path:polygon(10px 0,100% 0,100% 100%,0 100%,0 10px)}
.pill a:hover{color:var(--or)}
.pill.res{color:#0c0c0e;background:var(--or);gap:8px;padding:0 16px;clip-path:polygon(0 0,100% 0,100% calc(100% - 10px),calc(100% - 10px) 100%,0 100%)}
.pill.res svg{width:14px;height:14px}
.sidetab{position:fixed;right:0;top:50%;transform:translateY(-50%);z-index:55;width:40px;padding:14px 0 18px;background:var(--soft);box-shadow:-1px 0 0 var(--line);display:flex;flex-direction:column;align-items:center;gap:22px;border-radius:6px 0 0 6px}
.sidetab b{font-size:15px;font-weight:700;color:var(--or)}
.sidetab span{writing-mode:vertical-rl;transform:rotate(180deg);font-size:12px;font-weight:500}
@media(max-width:760px){.pill a:not(:first-child){display:none}.pill{gap:0}.sidetab{display:none}}

/* hero badge */
.hero{min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding-bottom:70px;position:relative;overflow:hidden}
.hang{display:flex;flex-direction:column;align-items:center;transform-origin:50% 0;animation:swing 4.5s ease-in-out infinite alternate;will-change:transform}
