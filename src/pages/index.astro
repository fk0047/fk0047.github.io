---
import Base from '../layouts/Base.astro';
import { P, S, C, X, SO, BR, O, OLD, RQ, CB, CI } from '../data/site.js';
import { BI } from '../data/brandicons.js';

const A = '/assets/projects/';
const chip = (n) => BR[n] || null;
const total = C.length + X.length + 1;
const featured = P.filter(p => p.f && p.i).slice(0, 10);
const rank = p => (p.i ? 2 : 0) + (p.f ? 1 : 0);
const projects = P.slice().sort((a, b) => rank(b) - rank(a));
const cats = ['All', ...new Set(P.map(p => p.c))];
const CC = {'AI':['#5e8fd8','#1c2638'],'SaaS & Platforms':['#2f6b56','#1f2c27'],'Digital Signage':['#a8c0d8','#1c2638'],'Marketing Tech':['#f26b1d','#7a2d0a'],'eCommerce & Payments':['#5e8fd8','#2a2050'],'Social & Messaging':['#ff8a3d','#a8325e'],'Enterprise & Media':['#1c2638','#5e8fd8'],'Web3 & Crypto':['#f2a51d','#5b3d9e'],'Mobile':['#2f6b56','#a8c0d8'],'Healthcare':['#a8c0d8','#2f6b56'],'Earlier work':['#6e6e73','#2a2a2c']};
const googleFeat = C.filter(c => c[6]).slice(0, 6);
const restCerts = C.filter(c => !c[6]).concat(C.filter(c => c[6]).slice(6));
const view = c => c[4] ? `/certificates/${c[4]}.pdf` : '';
const extraName = x => x.replace(/ \(.*\)$/, '');
const extraIss = x => (x.match(/\((.*)\)$/) || ['', ''])[1];
const lastPart = m => m.split(' · ').slice(-1)[0];
const orgs = O.map((o, i) => i === 2 ? { ...o, m: 'Los Angeles, CA · Remote · 2022' } : i === 3 ? { ...o, m: 'Los Angeles, CA · Remote · 2021' } : o);
const statement = 'I lead the team, I talk to the client, and I ship the product. Every time.'.split(' ');
---
<Base>
<nav id="nav"><div class="wrap">
  <a class="brand" href="#"><b>Fahad Khan</b><small>AI Product Manager</small></a>
  <div class="links" id="links"><a href="#highlights">Highlights</a><a href="#work">Work</a><a href="#brands">Brands</a><a href="#experience">Experience</a><a href="#skills">Skills</a><a href="#credentials">Credentials</a><a href="#praise">Praise</a></div>
  <a class="hire" href="#contact">Contact</a>
  <button class="menu" id="menu" aria-label="Open menu" aria-expanded="false">&#9776;</button>
</div></nav>

<header class="hero"><div class="glow" aria-hidden="true"></div><div class="wrap">
  <img class="face ld" style="--d:.05s" src="/assets/fahad.jpg" alt="Fahad Khan" width="104" height="104">
  <p class="sig ld" style="--d:.2s">Fahad Khan</p>
  <p class="tag ld" style="--d:.3s">Product · AI · Delivery</p>
  <h1 class="ld" style="--d:.35s" aria-label="AI Product Manager"><span class="grad" aria-hidden="true"><span id="role">AI Product Manager</span></span><span class="caret" aria-hidden="true"></span></h1>
  <p class="lede ld" style="--d:.55s">I turn ideas into products people use. <b>AI, SaaS, signage, marketing tech, commerce and Web3</b>, from the first spec to launch day.</p>
  <div class="ctas ld" style="--d:.7s"><a class="btn" href="#contact">Get in touch</a><a class="link" href="/assets/Fahad_Khan_Resume.pdf" target="_blank">Download CV</a></div>
  <div class="scrollcue ld" style="--d:1s" aria-hidden="true"><span></span></div>
  <div class="stats ld" style="--d:.85s">
    <div><b data-count="50" data-suf="+">50+</b><span>products shipped</span></div>
    <div><b data-count="30" data-suf="+">30+</b><span>API integrations</span></div>
    <div><b data-count={total}>{total}</b><span>certifications</span></div>
    <div><b data-count="9" data-suf=" yrs">9 yrs</b><span>remote and global</span></div>
  </div>
</div></header>

<section class="lit" aria-label="Statement"><div class="wrap"><p class="lit-text" id="lit">{statement.map(w => <span>{w} </span>)}</p></div></section>

<section id="highlights">
  <div class="wrap head rv"><span class="eyebrow">Highlights</span><h2>Shipped. Live. In use.</h2></div>
  <div class="gal rv" id="gal">
    {featured.map(p => (
      <article class="g">
        <div class="t"><p class="big"><b>{p.t}.</b> {p.d}</p>
          <div class="row">{p.u && p.u.slice(0, 2).map(([n, h]) => <a class="link" href={h} target="_blank" rel="noopener">Visit {n}</a>)}<small>{p.w}</small></div>
        </div>
        <div class={`pic blurin${p.x ? ' pdf' : ''}`}><img loading="lazy" src={`${A}${p.i[0]}.jpg`} alt={`${p.t} screenshot`}></div>
      </article>
    ))}
  </div>
  <div class="gnav"><button class="arr" id="prev" aria-label="Previous">&#8249;</button><div class="dots" id="dots"></div><button class="arr" id="pp" aria-label="Pause slideshow">&#10074;&#10074;</button><button class="arr" id="next" aria-label="Next">&#8250;</button></div>
</section>

<section id="work"><div class="wrap wide">
  <div class="head rv" style="padding:0"><span class="eyebrow">Work</span><h2>Everything I've delivered.</h2><p class="lede">Pick a category. Open any project for the details.</p></div>
  <div class="seg rv" id="pseg" role="tablist" aria-label="Project categories">{cats.map((c, i) => <button role="tab" data-c={c} class={i === 0 ? 'on' : ''} aria-selected={i === 0 ? 'true' : 'false'}>{c}</button>)}</div>
  <div class="grid" id="grid">
    {projects.map(p => { const g = CC[p.c] || ['#6e6e73', '#2a2a2c']; return (
      <div class="card" data-c={p.c}>
        {p.i ? <div class={`im blurin${p.x ? ' pdf' : ''}`}><img loading="lazy" src={`${A}${p.i[0]}.jpg`} alt={`${p.t} screenshot`}></div>
             : <div class="im cv" style={`--c1:${g[0]};--c2:${g[1]}`}><span>{p.t}</span></div>}
        <div class="bd"><span class="k">{p.c}</span><h3>{p.t}</h3><p>{p.d}</p>
          <details><summary>Learn more</summary>
            {p.b && <ul>{p.b.map(x => <li>{x}</li>)}</ul>}
            <div class="chips">{p.s.map(n => { const b = chip(n); return b ? <span class="chip" style={`--b:${b[0]}`}>{b[1] ? <img src={'/' + b[1]} alt="" /> : <i></i>}{n}</span> : <span class="chip p">{n}</span>; })}</div>
            <p class="when">{p.w}</p>
          </details>
          {p.u && <div class="go">{p.u.map(([n, h]) => <a class="link" href={h} target="_blank" rel="noopener">{n}</a>)}</div>}
        </div>
      </div>); })}
  </div>
  <div class="showall"><button class="btn alt" id="allbtn">Show all</button></div>
</div></section>

<section id="brands"><div class="wrap wide">
  <div class="head rv" style="padding:0"><span class="eyebrow">Brands</span><h2>Trusted by names you know.</h2><p class="lede">And connected to every channel their customers use.</p></div>
  <div class="logos rv">
    {[['truevalue','True Value'],['doitbest','Do it Best',1],['ace','Ace Hardware'],['timbertech','TimberTech (AZEK)'],['jameshardie','James Hardie'],['milwaukee','Milwaukee Tool',1],['orgill','Orgill'],['disney','Disney',1],['spectrum','Spectrum'],['bigmarker','BigMarker'],['ezadtv','EZ-AD TV'],['dentaloo','Dentaloo'],['issa','Issa Dental Group',1],['soch','SOCH Clinics']].map(([f, n, t]) => <img class={t ? 't' : ''} src={`/assets/clients/${f}.png`} alt={n}>)}
  </div>
  <div class="socials rv">{SO.map(([f, n]) => BI[f] && <div class="so" title={n} style={`--c:${BI[f].bg === 'IG' ? '#E1306C' : BI[f].bg}`}><span class={`tile ${f}`} style={BI[f].bg === 'IG' ? '' : `background:${BI[f].bg}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={BI[f].p}/></svg></span>{n}</div>)}</div>
  <p class="note rv">Plus email and marketing platforms: Adobe Marketo Engage, Adobe Campaign, Adobe Journey Optimizer, Mailgun, Mailchimp, HubSpot and Salesforce.</p>
</div></section>

<section id="experience"><div class="wrap">
  <div class="head rv" style="padding:0"><span class="eyebrow">Experience</span><h2>Promoted from within. Twice.</h2><p class="lede">Leading developers, QA, UI/UX and marketing, side by side with IT, sales and support.</p></div>
  <div class="orgs">
    {orgs.map((o, i) => (
      <details class="org rv" style={`--d:${i * 0.06}s`}>
        <summary><h3>{o.n}</h3><span class="when">{lastPart(o.m)}</span>
          <span class="path">{o.r.map((r, k) => <>{k > 0 && (r.p ? <span class="ar">&#8594;</span> : <span class="ar">+</span>)}<b>{r.t.split(' / ')[0]}</b></>)}</span>
          <span class="more">Learn more</span></summary>
        {o.r.slice().reverse().map(r => (
          <div class="role"><h4>{r.t}{r.p && <span class="pr">Promoted</span>}</h4><p class="rw">{r.w} · {o.m.split(' · ').slice(0, 2).join(' · ')}</p><ul>{r.b.map(x => <li>{x}</li>)}</ul></div>
        ))}
      </details>
    ))}
  </div>
  <details class="older"><summary class="btn alt">Show earlier roles</summary>
    <div class="orgs" style="margin-top:14px">
      {OLD.map(o => (
        <details class="org"><summary><h3>{o.n}</h3><span class="when">{o.r[0].w}</span><span class="path"><b>{o.r[0].t}</b></span><span class="more">Learn more</span></summary>
          {o.r.map(r => <div class="role"><p class="rw">{o.m}</p><ul>{r.b.map(x => <li>{x}</li>)}</ul></div>)}
        </details>
      ))}
    </div>
  </details>
</div></section>

<section id="skills"><div class="wrap wide">
  <div class="head rv" style="padding:0"><span class="eyebrow">Skills</span><h2>Fluent in the whole stack.</h2><p class="lede">From the models to the money. Choose an area.</p></div>
  <div class="seg rv" id="sseg" role="tablist" aria-label="Skill areas">{S.map(([h], i) => <button role="tab" data-i={i} class={i === 0 ? 'on' : ''} aria-selected={i === 0 ? 'true' : 'false'}>{h}</button>)}</div>
  <div class="panels rv">
    {S.map(([h, l], i) => (
      <div class="panel" role="tabpanel" data-i={i} hidden={i !== 0}><h3>{h}</h3>
        <div class="chips">{l.map(n => { const b = chip(n); return b ? <span class="chip" style={`--b:${b[0]}`}>{b[1] ? <img src={'/' + b[1]} alt="" /> : <i></i>}{n}</span> : <span class="chip p">{n}</span>; })}</div>
      </div>
    ))}
  </div>
</div></section>

<section id="credentials"><div class="wrap wide">
  <div class="head rv" style="padding:0"><span class="eyebrow">Credentials</span><h2>{total} certifications.</h2><p class="lede">Led by Google's professional certificates. <b>PMP</b> is next.</p></div>
  <div class="feat">
    {googleFeat.map((c, i) => (
      <div class="fc rv" style={`--d:${(i % 3) * 0.08}s`}>
        {c[4] && <img loading="lazy" src={`/certificates/thumbs/${c[4]}.jpg`} alt={`${c[0]} certificate`}>}
        <div class="bd"><small>Google Professional Certificate · {c[2]}</small><b>{c[0]}</b>
          <div class="go">{c[3] && <a class="link" href={c[3]} target="_blank" rel="noopener">Verify</a>}{view(c) && <a class="link" href={view(c)} target="_blank">View</a>}</div></div>
      </div>
    ))}
  </div>
  <div class="credrow rv"><h3>Verified on Credly</h3><a class="link" href="https://www.credly.com/users/fk0047" target="_blank" rel="noopener">See all badges</a></div>
  <div class="strip rv">{CB.map(b => <a class="bdg" href="https://www.credly.com/users/fk0047" target="_blank" rel="noopener"><img loading="lazy" src={`${CI}${b[3]}`} alt=""><span>{b[0]}</span></a>)}</div>
  <details class="allc"><summary class="btn alt">See all {total} certifications</summary>
    <div class="list">
      {restCerts.map(c => <div class="ci"><b>{c[0]}</b><small>{c[1]} · {c[2]}</small><br>{c[3] && <a href={c[3]} target="_blank" rel="noopener">Verify</a>}{view(c) && <a href={view(c)} target="_blank">View</a>}</div>)}
      {X.map(x => <div class="ci"><b>{extraName(x)}</b><small>{extraIss(x)}</small></div>)}
    </div>
  </details>
</div></section>

<section id="praise">
  <div class="wrap head rv"><span class="eyebrow">Praise</span><h2>In their words.</h2><p class="lede">Clients, teammates and managers, from LinkedIn and experience letters.</p></div>
  <div class="gal quotes rv" id="quotes">{RQ.map(q => <article class="g"><p>&ldquo;{q[0]}&rdquo;</p><cite>{q[1]}<span>{q[2]}</span></cite></article>)}</div>
  <p class="note"><a class="link" href="https://www.linkedin.com/in/fk0047/details/recommendations/" target="_blank" rel="noopener">Read them on LinkedIn</a></p>
</section>

<section id="beyond"><div class="wrap wide">
  <div class="head rv" style="padding:0"><span class="eyebrow">Beyond work</span><h2>Curious, always.</h2></div>
  <div class="life">
    <div class="lt rv" style="--c:linear-gradient(160deg,#3a3a3c,#0b0b0c);--d:0s"><h3>Gaming</h3><p>Lifelong gamer, new releases and old favourites.</p></div>
    <div class="lt rv" style="--c:linear-gradient(160deg,#2c2c2e,#000);--d:.08s"><h3>Tech</h3><p>First in line for every new launch, model and gadget.</p></div>
    <div class="lt rv" style="--c:linear-gradient(160deg,#48484a,#111);--d:.16s"><h3>Anime</h3><p>From the classics to this season's talk of the town.</p></div>
    <div class="lt rv" style="--c:linear-gradient(160deg,#1c1c1e,#3a3a3c);--d:.24s"><h3>Shows &amp; movies</h3><p>Binge-watching, and movie nights out with friends.</p></div>
  </div>
  <p class="edu rv"><b>BSc Software Engineering</b>, COMSATS University Islamabad, 2014 – 2018</p>
</div></section>

<section id="contact"><div class="wrap cbox">
  <div class="rv"><span class="eyebrow">Contact</span><h2>Let's build what's next.</h2><p class="lede">Open to remote roles and contract work, any time zone.</p></div>
  <div class="cways rv">
    <a class="cw" href="https://wa.me/923414480088" target="_blank"><span class="tile sm whatsapp" style={`background:${BI.whatsapp.bg};--c:${BI.whatsapp.bg}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={BI.whatsapp.p}/></svg></span><span><small>WhatsApp</small><b>+92 341 4480088</b></span></a>
    <a class="cw" href="mailto:chronos0047@gmail.com"><span class="tile sm gmail" style={`background:${BI.gmail.bg};--c:${BI.gmail.bg}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={BI.gmail.p}/></svg></span><span><small>Email</small><b>chronos0047@gmail.com</b></span></a>
    <a class="cw" href="https://www.linkedin.com/in/fk0047/" target="_blank"><span class="tile sm linkedin" style={`background:${BI.linkedin.bg};--c:${BI.linkedin.bg}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={BI.linkedin.p}/></svg></span><span><small>LinkedIn</small><b>in/fk0047</b></span></a>
    <a class="cw" href="https://github.com/fk0047" target="_blank"><span class="tile sm github" style={`background:${BI.github.bg};--c:${BI.github.bg}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={BI.github.p}/></svg></span><span><small>GitHub</small><b>fk0047</b></span></a>
  </div>
  <details class="msg"><summary class="link">Write a message here</summary>
    <form id="cform" novalidate>
      <label>Your name<input id="cname" autocomplete="name" required></label>
      <label>Company (optional)<input id="ccomp" autocomplete="organization"></label>
      <label>Message<textarea id="cmsg" required></textarea></label>
      <div class="via"><input type="radio" name="via" id="viaWa" value="wa" checked><label for="viaWa">Send by WhatsApp</label><input type="radio" name="via" id="viaEm" value="em"><label for="viaEm">Send by email</label></div>
      <button class="btn" type="submit">Send message</button>
      <p class="fnote" id="fnote">Opens WhatsApp or your email app with your message ready.</p>
    </form>
  </details>
</div></section>

<footer><div class="wrap"><span>Copyright © {new Date().getFullYear()} Fahad Khan. Pakistan · Remote / Global.</span><span><a href="https://www.linkedin.com/in/fk0047/" target="_blank">LinkedIn</a> · <a href="https://github.com/fk0047" target="_blank">GitHub</a> · <a href="https://www.credly.com/users/fk0047" target="_blank">Credly</a> · <a href="/assets/Fahad_Khan_Resume.pdf" target="_blank">CV</a></span></div></footer>
</Base>

<style is:global>
nav{position:sticky;top:0;z-index:50;height:52px;border-bottom:1px solid rgba(255,255,255,.12);background:rgba(22,22,23,.72);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);transition:background .3s}
nav .wrap{height:100%;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;flex-direction:column;line-height:1.1;color:#f5f5f7}.brand b{font-size:19px;font-weight:600;letter-spacing:-.01em}.brand small{font-size:11px;color:#86868b}
.links{display:flex;gap:24px;font-size:13px;color:rgba(255,255,255,.82);letter-spacing:-.01em;height:100%;align-items:center}
.links a{transition:color .2s;height:100%;display:flex;align-items:center;border-bottom:1px solid transparent;margin-bottom:-1px}.links a:hover{color:#fff}.links a.on{color:#fff;border-bottom-color:#f5f5f7}
.hire{font-size:13px;background:#0071e3;color:#fff;padding:5px 14px;border-radius:980px}
.menu{display:none;background:none;border:0;color:#f5f5f7;width:44px;height:52px;font-size:20px;cursor:pointer}
@media(max-width:833px){.links{height:auto;display:none;position:absolute;top:52px;left:0;right:0;flex-direction:column;gap:0;background:#161617;padding:8px 0 16px}.links.open{display:flex}.links a{padding:12px 32px;font-size:20px;font-weight:600;color:#e8e8ed}.menu{display:block}.hire{display:none}}

.hero{background:#000;text-align:center;padding:clamp(76px,10vw,120px) 0 clamp(64px,8vw,96px);position:relative;overflow:hidden}
.glow{position:absolute;inset:-30% -10% auto;height:120%;background:radial-gradient(45% 30% at 50% 38%,rgba(255,255,255,.10),transparent 70%),radial-gradient(30% 38% at 18% 20%,rgba(90,200,250,.10),transparent 70%),radial-gradient(30% 38% at 82% 22%,rgba(214,110,253,.10),transparent 70%);filter:blur(10px);animation:drift 18s var(--ease) infinite alternate;pointer-events:none}
@keyframes drift{to{transform:translate3d(3%,4%,0) scale(1.06)}}
.hero .wrap{position:relative}
.face{width:104px;height:104px;border-radius:50%;object-fit:cover;margin:0 auto 22px;box-shadow:0 0 0 1px rgba(255,255,255,.25),0 0 80px rgba(255,255,255,.12);filter:grayscale(.15)}
.sig{font-family:var(--sig);font-size:clamp(72px,11vw,150px);line-height:.9;color:#fff;font-weight:400;letter-spacing:0;margin:-6px 0 4px;text-shadow:0 0 40px rgba(255,255,255,.18)}
.hero .tag{margin-bottom:22px}
.scrollcue{display:flex;justify-content:center;margin-top:46px}.scrollcue span{width:1px;height:64px;background:linear-gradient(#fff,transparent);transform-origin:top;animation:cue 2.4s var(--ease) infinite}
@keyframes cue{0%{transform:scaleY(0)}50%{transform:scaleY(1)}100%{transform:scaleY(1);opacity:0}}
.hero h1{font-family:var(--cond);text-transform:uppercase;font-weight:500;font-size:clamp(40px,6.4vw,88px);letter-spacing:.01em;line-height:1.04;letter-spacing:-.015em;font-weight:700;margin-top:4px}
.grad{background:var(--grad);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:sheen 8s linear infinite}
@keyframes sheen{to{background-position:-200% 0}}
.caret{display:inline-block;width:.04em;height:.8em;margin-left:.04em;background:#fff;vertical-align:-.04em;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.hero .lede{max-width:640px;margin:20px auto 0;color:#a1a1a6}.hero .lede b{color:#f5f5f7}
.ctas{display:flex;justify-content:center;align-items:center;gap:28px;flex-wrap:wrap;margin-top:34px}
.hero .wrap{will-change:transform,opacity}
.pz{overflow:hidden}
.ld{opacity:0;transform:translateY(24px);animation:rise 1.1s var(--ease) forwards;animation-delay:var(--d,0s)}
@keyframes rise{to{opacity:1;transform:none}}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));max-width:880px;margin:76px auto 0;border-top:1px solid rgba(255,255,255,.14)}
.stats div{padding:22px 10px 0}
.stats b{display:block;font-family:var(--cond);font-size:clamp(40px,5vw,64px);font-weight:500;background:var(--chrome);-webkit-background-clip:text;background-clip:text;color:transparent;letter-spacing:-.01em;color:#f5f5f7;font-variant-numeric:tabular-nums}
.stats span{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#86868b}
@media(max-width:600px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}

.lit{background:#000;padding:clamp(60px,9vw,120px) 0 clamp(90px,12vw,160px)}
.lit-text{font-family:var(--cond);text-transform:uppercase;font-size:clamp(38px,5.6vw,80px);line-height:1;font-weight:500;letter-spacing:.005em;max-width:980px;margin:0 auto;text-align:left}
.lit-text span{color:#f5f5f7;opacity:.18;transition:opacity .35s linear}
.lit-text span.on{opacity:1}

.gal{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:0 max(22px,calc((100vw - 1024px)/2 + 22px)) 8px;scroll-padding:0 max(22px,calc((100vw - 1024px)/2 + 22px))}
.gal::-webkit-scrollbar{display:none}
.g{flex:0 0 min(900px,84vw);scroll-snap-align:start;border-radius:28px;overflow:hidden;background:#000;border:1px solid var(--stroke);display:flex;flex-direction:column;min-height:540px}
.g .t{padding:40px 44px 0}
.g .big{font-family:var(--disp);font-size:clamp(21px,2.3vw,28px);line-height:1.18;font-weight:600;color:#86868b;letter-spacing:.007em;max-width:640px}
.g .big b{color:#f5f5f7;font-weight:600}
